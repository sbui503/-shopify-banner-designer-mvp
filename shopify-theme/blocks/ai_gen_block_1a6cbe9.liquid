{% doc %}
  @prompt
    Create Design Custom Banner that will provide the image url for my design tool hosted https://teamsportbanners.vercel.app for my customer to design the product
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-design-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-design-banner__container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-design-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.spacing }}px;
    font-weight: 500;
  }

  .ai-design-banner__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 {{ block.settings.spacing }}px;
    line-height: 1.5;
  }

  .ai-design-banner__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-design-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-design-banner__icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
  }

  .ai-design-banner__image-preview-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.spacing }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-design-banner__image-preview-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-design-banner__placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    margin: 0 0 {{ block.settings.spacing }}px;
  }

  .ai-design-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    max-height: 400px;
  }

  @media screen and (max-width: 749px) {
    .ai-design-banner__container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-design-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-design-banner__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

{% assign tsb_product_handle = product.handle | default: '' | strip %}
{% unless tsb_product_handle == 'banner-carrying-bag' or tsb_product_handle == 'banner-carrying-bag-and-pole-kit' %}
<design-banner-{{ ai_gen_id }}
  class="ai-design-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-design-banner__container-{{ ai_gen_id }}">
    {% if block.settings.show_image and block.settings.preview_image %}
      <div class="ai-design-banner__image-preview-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.preview_image | image_url: width: 1200 }}"
          alt="{{ block.settings.preview_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.preview_image.width }}"
          height="{{ block.settings.preview_image.height }}"
        >
      </div>
    {% elsif block.settings.show_image %}
      <div class="ai-design-banner__placeholder-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-design-banner__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-design-banner__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a
        href="#"
        class="ai-design-banner__button-{{ ai_gen_id }}"
        data-design-tool-url="https://teamsportbanners.vercel.app"
        data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 2000 }}{% endif %}"
      >
        {% if block.settings.show_icon %}
          <svg
            class="ai-design-banner__icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
            <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
            <path d="M2 2l7.586 7.586"></path>
            <circle cx="11" cy="11" r="2"></circle>
          </svg>
        {% endif %}
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</design-banner-{{ ai_gen_id }}>
{% endunless %}

<script>
  (function() {
    class DesignBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-design-banner__button-{{ ai_gen_id }}');
        if (this.button) {
          this.setupDesignTool();
        }
      }

      setupDesignTool() {
        this.button.addEventListener('click', (event) => {
          event.preventDefault();

          const designToolUrl = this.button.getAttribute('data-design-tool-url');
          const productImage = this.button.getAttribute('data-product-image');

          if (designToolUrl) {
            const params = new URLSearchParams();

            if (productImage) {
              params.append('imageUrl', productImage);
            }

            const fullUrl = productImage
              ? designToolUrl + '?' + params.toString()
              : designToolUrl;

            window.open(fullUrl, '_blank');
          }
        });
      }
    }

    customElements.define('design-banner-{{ ai_gen_id }}', DesignBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Design custom banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design your custom banner"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Create your personalized team banner with our easy-to-use design tool. Upload your images, add text, and customize colors."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Start designing"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show design icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Preview image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show preview image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "preview_image",
      "label": "Preview image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Element spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f6f6f6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Button text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Design custom banner"
    }
  ]
}
{% endschema %}
