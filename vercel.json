{
  "functions": {
    "api/image-proxy.js": {
      "maxDuration": 30
    },
    "api/designs.js": {
      "maxDuration": 30
    },
    "api/send-proof-email.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/team-banner",
      "destination": "/"
    },
    {
      "source": "/team-banner/:path*",
      "destination": "/"
    },
    {
      "source": "/collections",
      "destination": "/"
    },
    {
      "source": "/collections/:path*",
      "destination": "/"
    },
    {
      "source": "/products",
      "destination": "/"
    },
    {
      "source": "/products/:path*",
      "destination": "/"
    },
    {
      "source": "/pages",
      "destination": "/"
    },
    {
      "source": "/pages/:path*",
      "destination": "/"
    },
    {
      "source": "/baseball-banners",
      "destination": "/"
    },
    {
      "source": "/baseball-banners/:path*",
      "destination": "/"
    },
    {
      "source": "/softball-banners",
      "destination": "/"
    },
    {
      "source": "/softball-banners/:path*",
      "destination": "/"
    },
    {
      "source": "/soccer-banners",
      "destination": "/"
    },
    {
      "source": "/soccer-banners/:path*",
      "destination": "/"
    },
    {
      "source": "/custom-design-request",
      "destination": "/"
    },
    {
      "source": "/design-tool",
      "destination": "/"
    },
    {
      "source": "/design-tool/:path*",
      "destination": "/"
    },
    {
      "source": "/cart",
      "destination": "/"
    },
    {
      "source": "/checkout",
      "destination": "/"
    },
    {
      "source": "/checkout/:path*",
      "destination": "/"
    },
    {
      "source": "/account",
      "destination": "/"
    },
    {
      "source": "/account/:path*",
      "destination": "/"
    },
    {
      "source": "/order-detail",
      "destination": "/"
    },
    {
      "source": "/sign-in",
      "destination": "/"
    },
    {
      "source": "/sign-up",
      "destination": "/"
    },
    {
      "source": "/official-notice",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/team-banner-assets.shopify.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/team-banner-products.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/team-banner-layer-maps.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/svg-layer-templates.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/svg-layer-templates/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
